{
    "_meta": {
        "用途": "Claude Code 手动配置名单：DeepSeek / kimi-code / kimi-api / glm。cs.mjs 只读这里，菜单顺序即显示顺序。",
        "key": "模板不含 key；keyFile 运行时注入 ANTHROPIC_AUTH_TOKEN。DeepSeek 使用 C:/Users/admin/dev/deepseek-api-key.txt。",
        "约束": "不改 ~/.claude/settings.json；cs set 永久切换仅用户手动执行。"
    },
    "profiles": {
        "deepseek": {
            "desc": "provider: DeepSeek, key: deepseek, model: deepseek-flash[1m]",
            "keyFile": "deepseek-api-key.txt",
            "env": {
                "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
                "ANTHROPIC_MODEL": "deepseek-flash[1m]",
                "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-flash[1m]",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-flash[1m]",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash[1m]",
                "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro[1m]",
                "CLAUDE_CODE_EFFORT_LEVEL": "max"
            }
        },
        "kimi-code": {
            "desc": "provider: kimi 订阅(kimi.com/code), key: kimi-code, model: k3.1-pro[1m]",
            "keyFile": "kimi-code-api-key.txt",
            "env": {
                "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
                "ANTHROPIC_MODEL": "k3.1-pro[1m]",
                "ANTHROPIC_DEFAULT_OPUS_MODEL": "k3.1-pro[1m]",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": "kimi-k3[1m]",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi-k3[1m]",
                "ANTHROPIC_DEFAULT_FABLE_MODEL": "k3.1-pro[1m]",
                "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1048576",
                "CLAUDE_CODE_EFFORT_LEVEL": "high"
            }
        },
        "kimi-api": {
            "desc": "provider: kimi API 按量(platform.kimi.com), key: kimi-api, model: kimi-k3.1-pro[1m]",
            "keyFile": "kimi-api-key.txt",
            "env": {
                "ANTHROPIC_BASE_URL": "https://api.moonshot.cn/anthropic",
                "ANTHROPIC_MODEL": "kimi-k3.1-pro[1m]",
                "ANTHROPIC_DEFAULT_OPUS_MODEL": "kimi-k3.1-pro[1m]",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": "kimi-k3[1m]",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi-k3[1m]",
                "ANTHROPIC_DEFAULT_FABLE_MODEL": "kimi-k3.1-pro[1m]",
                "ENABLE_TOOL_SEARCH": "false",
                "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1048576",
                "CLAUDE_CODE_EFFORT_LEVEL": "high"
            }
        },
        "glm": {
            "desc": "provider: glm, key: glm, model: glm-5.3[1m]",
            "keyFile": "glm-api-key.txt",
            "env": {
                "ANTHROPIC_BASE_URL": "https://open.bigmodel.cn/api/anthropic",
                "ANTHROPIC_MODEL": "glm-5.3[1m]",
                "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
                "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3[1m]",
                "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3[1m]",
                "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
                "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
                "API_TIMEOUT_MS": "3000000"
            }
        }
    }
}
