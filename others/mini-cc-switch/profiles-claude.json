      "keyFile": "gravitex-api-key-cyx.txt",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.gravitex.ai",
        "ANTHROPIC_MODEL": "claude-opus-5-5",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-fable-5-1",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
